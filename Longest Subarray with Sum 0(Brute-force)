class Solution {
    int maxLength(int arr[])
    {
       int maxLength=0;
        for(int i=0;i<arr.length;i++)
        {
            int sum=0;
            for(int j=i;j<arr.length;j++)
            {
                sum=sum+arr[j];
                if(sum==0)
                {
                    maxLength=Math.max(maxLength,j-i+1);
                }
            }
        }
        return maxLength;
    }
}
